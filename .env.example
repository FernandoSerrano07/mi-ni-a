# Copia este archivo como .env y llena los valores
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
TIMEZONE=America/El_Salvador

# Base de datos: en local usa SQLite; en producción pega la URL de Postgres (Neon / Supabase)
DATABASE_URL=sqlite:///recordatorios.db

# Llaves para notificaciones (python generar_vapid.py)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# 1 = el servidor revisa recordatorios cada 30 s
ENABLE_SCHEDULER=1
# Clave para /cron/tick si usas un cron externo (cron-job.org)
CRON_SECRET=

# En local (sin HTTPS) pon 0. En producción 1.
COOKIE_SECURE=0
